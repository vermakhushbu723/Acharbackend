# --- Required ---
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep the database name, e.g. /acharika
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/acharika?retryWrites=true&w=majority
# Optional: comma-separated DNS servers, set if you get `querySrv ECONNREFUSED` on Windows, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development
# Public storefront URL (no trailing slash), used in sitemap.xml and robots.txt
SITE_URL=http://localhost:5173
# Browser origins allowed to call this API
WEBSITE_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- First owner account (created by `npm run seed`) ---
SEED_ADMIN_EMAIL=owner@acharika.example
SEED_ADMIN_PASSWORD=ChangeMe@12345
SEED_ADMIN_NAME=Store Owner

# --- Razorpay (optional). Leave blank to run COD-only. Use TEST keys first. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
